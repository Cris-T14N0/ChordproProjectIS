<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editor - ChordPro</title>
    <link rel="stylesheet" href="/css/editor.css">
</head>
<body style="margin: 0; background: #fafaf9;">
    <%- include('../../partials/navbar') %>
    
    <div class="main-content">
        <div class="editor-container">
            <div class="editor-header">
                <h1 id="pageTitle">Nova Música</h1>
                <div class="header-actions">
                    <button class="btn btn-secondary" onclick="window.location.href='/library'">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                        Cancelar
                    </button>
                    <button class="btn btn-primary" id="saveBtn" onclick="saveSong()">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                        </svg>
                        Guardar
                    </button>
                </div>
            </div>

            <div id="message" class="message hidden"></div>

            <div class="metadata-form">
                <div class="form-group">
                    <label for="title">Título *</label>
                    <input type="text" id="title" placeholder="Nome da música" required>
                </div>
                <div class="form-group">
                    <label for="artist">Artista</label>
                    <input type="text" id="artist" placeholder="Nome do artista">
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="isPublic" checked>
                        <span>Tornar pública (visível para outros utilizadores)</span>
                    </label>
                </div>
            </div>

            <div class="editor-toggle">
                <button class="toggle-btn active" onclick="switchView('edit')">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Editar
                </button>
                <button class="toggle-btn" onclick="switchView('preview')">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    Pré-visualizar
                </button>
            </div>

            <div class="editor-content">
                <div class="editor-panel active">
                    <h3>ChordPro</h3>
                    <textarea 
                        id="chordproInput" 
                        class="editor-textarea" 
                        placeholder="Digite ou cole o conteúdo ChordPro aqui...

Exemplo:
{title: Let It Be}
{artist: The Beatles}

[C]When I [G]find myself in [Am]times of trouble
[F]Mother Mary [C]comes to me
[C]Speaking words of [G]wisdom, let it [F]be [C]"
                    ></textarea>
                </div>

                <div class="preview-panel">
                    <h3>Pré-visualização</h3>
                    <div id="preview">
                        <p style="color: #94a3b8; text-align: center;">A pré-visualização aparecerá aqui...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Load ChordSheetJS FIRST -->
    <script src="/js/chordpro-parser.js"></script>
    <script src="/js/editor.js"></script>
    <script src="/js/auth-check.js"></script>
    
</body>
</html>