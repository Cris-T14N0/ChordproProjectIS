<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>Visualizador - ChordPro</title>
    <link rel="stylesheet" href="/css/viewer.css">
</head>
<body style="margin: 0; background: #fafaf9;">
    <%- include('../../partials/navbar') %>
    
    <div class="main-content">
        <div class="viewer-container">
            <div class="viewer-header">
                <div class="header-title">
                    <h1 id="songTitle">A carregar...</h1>
                    <div class="header-subtitle" id="songArtist"></div>
                    <!-- ⭐ Tag do dono (sempre visível) -->
                    <div id="ownerTagContainer"></div>
                </div>
                <div class="header-actions">
                    <a href="javascript:history.back()" class="btn btn-secondary">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        <span class="btn-text">Voltar</span>
                    </a>
                    <a href="#" id="editBtn" class="btn btn-secondary" style="display: none;">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        <span class="btn-text">Editar</span>
                    </a>
                    <button class="btn btn-primary btn-full-width" onclick="window.print()">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                        </svg>
                        <span class="btn-text">Imprimir</span>
                    </button>
                </div>
            </div>

            <div class="controls-bar">
                <div class="control-group">
                    <label>Tamanho:</label>
                    <div class="control-buttons">
                        <button onclick="adjustFontSize(-1)">A-</button>
                        <button onclick="adjustFontSize(1)">A+</button>
                    </div>
                </div>
                <div class="control-group">
                    <label>Tom:</label>
                    <div class="control-buttons">
                        <button onclick="transposeChords(-1)">♭</button>
                        <button onclick="transposeChords(0)">Reset</button>
                        <button onclick="transposeChords(1)">♯</button>
                    </div>
                </div>
            </div>

            <div class="viewer-content">
                <div class="song-display" id="songDisplay">
                    <p style="color: #94a3b8; text-align: center;">A carregar música...</p>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/chordpro-parser.js"></script>
    <script src="/js/viewer.js"></script>
</body>
</html>